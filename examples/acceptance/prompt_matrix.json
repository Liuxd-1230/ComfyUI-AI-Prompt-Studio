  "live_cases": [
    {
      "id": "llm-text",
      "path": "ModelProfile -> LLMGenerate(text)",
      "prompt": "用中文写三条可直接执行的雨夜摄影构图建议，每条一句。",
      "expected_effect": "Three concise Chinese suggestions; no JSON requirement.",
      "expected_checks": ["non-empty text", "Chinese response", "no provider error"],
      "status": "passed",
      "evidence": {"run_type": "live-production-node", "profile": "基元", "date": "2026-08-13", "result": "non-empty Chinese text; 3 numbered suggestions"}
    },
    {
      "id": "llm-json-schema",
      "path": "ModelProfile -> LLMGenerate(json_schema)",
      "prompt": "提取地点和天气：雨夜的上海外滩。",
      "expected_effect": "A JSON object matching the requested location/weather schema.",
      "expected_checks": ["parseable JSON", "required keys", "no provider error"],
      "status": "passed",
      "evidence": {"run_type": "live-production-node", "profile": "基元", "date": "2026-08-13", "result": "JSON parsed; location=上海外滩; weather=雨"}
    },
    {
      "id": "reference-text-bible-storyboard",
      "path": "ReferenceAnalyzer(text) -> CharacterBible -> StoryboardBuilder -> StoryboardSelect",
      "prompt": "林澈，黑色短发，琥珀色眼睛，深蓝长风衣。她在雨夜车站捡起一封信，抬头看见列车驶来。",
      "expected_effect": "Stable character anchor, model-neutral storyboard, and selectable scene/shot items.",
      "expected_checks": ["named character", "stable visible traits", "at least one scene", "select all succeeds"],
      "status": "passed",
      "evidence": {"run_type": "live-production-chain", "profile": "基元", "date": "2026-08-13", "result": "1 scene, 2 shots, select-all returned 2 items"}
    },
    {
      "id": "reference-image-bible",
      "path": "LoadImage -> ReferenceAnalyzer(image) -> CharacterBible",
      "prompt": "Analyze 640.jpg as a character reference and preserve observable identity only.",
      "expected_effect": "Visible hair, eyes, outfit, and accessories are shown in the anchor preview.",
      "expected_checks": ["vision call succeeds", "non-empty traits", "caption visible", "manifest has Picture source"],
      "status": "passed",
      "evidence": {"run_type": "live-comfyui-chain", "profiles": "LM vision + 基元", "date": "2026-08-12", "result": "640.jpg produced visible anchor, Bible and manifest"}
    },
    {
      "id": "image-studio-all-targets",
      "path": "ModelProfile/CharacterBible/StoryItem/Manifest -> PromptStudio",
      "prompt": "A young woman with a right-side ponytail reads a letter beside a rain-covered train window; medium shot, cool fluorescent light, preserve identity and do not add text.",
      "expected_effect": "Every public image target in both lanes returns a usable target-specific prompt; ANIMA output is English.",
      "expected_checks": ["12 target/lane cases", "non-empty positive", "validation has no errors", "session revision 1"],
      "status": "passed",
      "evidence": {"run_type": "live-production-matrix", "profile": "基元", "date": "2026-08-13", "result": "12/12 target-lane combinations returned validated prompts"}
    },
    {
      "id": "h3-all-modes",
      "path": "ModelProfile/Storyboard/CharacterBible/Manifest/media -> H3PromptStudio",
      "prompt": "Single continuous shot: the reference woman turns in a rose garden while the camera slowly orbits; preserve face, hair, clothing and accessories; only petals and fabric ambience.",
      "expected_effect": "Every H3 mode in both lanes returns the correct three-field or six-section protocol and legal media alignment.",
      "expected_checks": ["10 mode/lane cases", "[Shot 1]", "soundscape", "no validation errors", "mode-specific alignment"],
      "status": "passed",
      "evidence": {"run_type": "live-production-matrix", "profile": "基元", "date": "2026-08-13", "result": "10/10 mode-lane combinations; FL2VA and Ref2VA strict rerun after asset canonicalization"}
    },
    {
      "id": "session-refine-restore",
      "path": "PromptStudio/H3PromptStudio prompt_session feedback loop",
      "prompt": "Create, refine one local fact, restore the previous successful revision, and requeue the same nonce.",
      "expected_effect": "Revision history is stable; restore creates a new revision; same nonce makes zero new model calls.",
      "expected_checks": ["create", "refine", "restore-as-new", "same nonce no-op"],
      "status": "passed",
      "evidence": {"run_type": "automated-production-regression-plus-live-p5", "date": "2026-08-13", "result": "create/refine/restore/no-op and fingerprint failures covered"}
    }
